<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SiteLimiter</AssemblyName>
    <RootNamespace>SiteLimiter</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- COM interop (UI Automation) needs the untrimmed runtime -->
    <PublishTrimmed>false</PublishTrimmed>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Version>1.0.0</Version>
    <Product>MG SiteLimiter</Product>
    <AssemblyTitle>MG SiteLimiter</AssemblyTitle>
    <Authors>pantelmg</Authors>
    <Company>pantelmg</Company>
    <Description>MG SiteLimiter: Daily time limits for websites (github.com/pantelmg)</Description>
    <Copyright>github.com/pantelmg</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiteLimiter.Core\SiteLimiter.Core.csproj" />
    <EmbeddedResource Include="Service\dashboard.html" LogicalName="dashboard.html" />
    <EmbeddedResource Include="Assets\tray-dark.ico" LogicalName="tray-dark.ico" />
    <EmbeddedResource Include="Assets\tray-light.ico" LogicalName="tray-light.ico" />
    <None Remove="Assets\preview.png" />
  </ItemGroup>

</Project>
